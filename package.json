{
	"name": "job-hunt-management",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter '@job-hunt/web' build",
		"deploy": "bun run build && bun run --filter '@job-hunt/api' deploy",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
